# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, never in Flutter).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- FastAPI Backend ---
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://10.0.2.2:3000"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS="30"

# --- Supabase (Server & Client) ---
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# --- Google Maps & Places (Nearby Clinics) ---
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# --- Flutter Client (--dart-define) ---
# Pass via: flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=... --dart-define=API_BASE_URL=http://10.0.2.2:8000
API_BASE_URL="http://10.0.2.2:8000"
